{
  "name": "bookmycctv-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@bookmycctv/api",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace=@bookmycctv/api",
    "admin:bootstrap": "npm run admin:bootstrap --workspace=@bookmycctv/api",
    "test": "npm run test --workspace=@bookmycctv/api",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "eslint": "latest",
    "globals": "latest",
    "prettier": "latest",
    "typescript": "5.9.3",
    "typescript-eslint": "latest"
  }
}
