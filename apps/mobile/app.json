{
  "expo": {
    "name": "BookMyCCTV",
    "slug": "bookmycctv",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "scheme": "bookmycctv",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-notifications",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bookmycctv.mobile",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bookmycctv.mobile",
      "edgeToEdgeEnabled": true
    }
  }
}
